# --- Flask ---
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production-too
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

# --- Database ---
DATABASE_URL=postgresql://health:health@postgres:5432/health

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
# The Flutter app runs outside the Docker network and can't resolve
# `minio` — presigned URLs handed to it must point at a host it can reach.
# With docker-compose's default port mapping that's localhost:9000; unset
# entirely (falls back to S3_ENDPOINT_URL) when there's only one reachable
# host anyway, e.g. running the backend outside Docker.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=health-media
S3_REGION=us-east-1

# --- LLM provider: anthropic | openai | gemini | mock ---
# Leave as "mock" (or omit the matching API key) to run with zero live LLM
# calls — the extraction pipeline falls back to a deterministic keyword
# extractor automatically.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# --- Billing (Stripe subscriptions) ---
# Leave STRIPE_SECRET_KEY unset to run billing in "mock" mode: checkout
# instantly marks the account Premium, no network calls, no Stripe account
# needed. Fill all four in to go live against real Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=vitachat://billing/success
BILLING_CANCEL_URL=vitachat://billing/cancel
FREE_TIER_LOGBOOK_DAYS=30

# --- Push notifications (Firebase Cloud Messaging) ---
# Leave unset to run in "mock" mode: the reminder scheduler (quiet-nudge,
# streak-milestone) still runs on real triggers every 30 min, but delivery
# is just a logged row (GET /api/v1/push/log) instead of a real device
# push. Set to the path of a Firebase service-account JSON file to go live
# — the Flutter app also needs firebase_messaging wired in with matching
# platform config (google-services.json / GoogleService-Info.plist) before
# there's anything to actually push to.
FCM_CREDENTIALS_JSON=
